---
import Site from '../layouts/Site.astro';
import PostList from '../components/PostList.astro';
---
<Site title="Home" section="Home">
  <section class="hero">
    <p class="eyebrow">01 / ABOUT</p>
    <h1>Cheryl Zhang</h1>
    <p class="lead">Welcome to my personal site, a home for my résumé and writing.</p>
    <div class="actions"><a class="button" href="/resume/">View résumé ↗</a><a href="/blog/">Read the blog</a></div>
  </section>
  <section aria-labelledby="latest">
    <div class="heading"><h2 id="latest">Latest from the blog</h2><a href="/blog/">All posts ↗</a></div>
    <PostList />
  </section>
</Site>
